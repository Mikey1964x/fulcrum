# Copy this file to .env and fill in the values. .env is ignored by git.

# The GeoJSON link of the Fulcrum data share.
FULCRUM_SHARE_URL=https://web.fulcrumapp.com/shares/<share-token>.geojson

# Fulcrum login. A data share is normally readable by anyone holding the
# link, so these are only sent (as HTTP Basic auth) if the server refuses
# an anonymous request.
FULCRUM_USERNAME=
FULCRUM_PASSWORD=

# Where the GeoJSON and shapefile are written. Optional, default "data".
FULCRUM_OUTPUT_DIR=data
